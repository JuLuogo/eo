# 复制成 .env 后填写真实值（.env 已被 .dockerignore / .gitignore 排除）
# docker compose 与 deploy.sh（裸机 systemd）都会读取本文件。
#
# 优先级说明：这些环境变量只在「首次启动、config.json 里还没有该字段」时生效；
# 一旦你在 Web 控制台上改过并存档，就以 config.json 为准，不会被环境变量覆盖回去。
#
# 提示：用 `docker compose` 时，本文件同时用于 ${...} 插值，
#       所以这里写什么，容器里就拿什么（受支持的变量见 docker-compose.yml）。

# ---- 运行模式 ----
EO_MODE=web                 # web=带管理页面 / monitor=纯后台循环 / scan=跑一次
EO_WEB_PORT=8787            # 三台机器请分别用 8787 / 8788 / 8789，避免端口冲突
EO_WEB_TOKEN=               # 留空自动生成；建议显式指定，重启后令牌不变
EO_WEB_HOST=0.0.0.0         # 容器内监听地址；只走反代/隧道时改 127.0.0.1

# 宿主机监听地址：默认所有网卡；只想本机访问就设 127.0.0.1（再配 SSH 隧道）
EO_BIND=0.0.0.0

# ---- 平台与运营商 ----
# 留空即可：程序按 EO_NETWORK 自动推导出 eo-/esa-/cft- 三个平台的本运营商变体。
# 只有想精确指定组合时才填，例如 EO_PLATFORMS=eo-lt,cft-lt
EO_PLATFORMS=
EO_NETWORK=lt               # 这台机器所在运营商：lt=联通 / dx=电信 / yd=移动

# ---- 调度 ----
EO_INTERVAL=300             # 每隔多少秒跑一轮（也可在 Web 上随时改，下一轮生效）
EO_WINDOW=                  # 时间窗口，例如 00:00-07:00；留空=全天
EO_AUTO_RUN=false           # 容器启动后是否自动开始循环
EO_CYCLES=                  # monitor 模式只跑几轮（留空=一直跑）
EO_EXTRA_ARGS=              # 追加任意参数，例如 --ping --retries 2

# ---- 连接限速（共享出口的机器务必保留）----
EO_RATE=100                 # 全平台合计 TCP 连接上限（连接/秒），0=不限速
EO_WORKERS=                 # 单平台并发数，留空用内置默认 80
EO_TIMEOUT=                 # 单次探测超时秒数，留空用内置默认 3
EO_RETRIES=                 # 失败重试次数，留空用内置默认 1
EO_PING=                    # 1=探测前先用 ICMP 预筛（默认关；部分机房屏蔽 ICMP）

# ---- 日志 ----
EO_LOG_BUFFER=500           # 网页实时日志保留条数（内存环形缓冲，不落盘）

# ---- 停止行为 ----
EO_SHUTDOWN_GRACE=5         # docker stop / SIGTERM 后给本轮收尾的秒数（< docker 宽限期）

# ---- 网段文件 ----
EO_SEED_TARGETS=1           # 1=宿主机 targets/ 缺文件时自动从镜像内置补齐

# ---- DNS 下发（三平台统一走华为云）----
HUAWEI_AK=
HUAWEI_SK=
HUAWEI_REGION=cn-north-4
HUAWEI_ZONE=                # 留空则由平台配置里的 zone 决定
HUAWEI_RECORD=              # 留空则由平台配置里的 record 决定
CLOUDFLARE_API_TOKEN=       # 只有用 Cloudflare 当 DNS 服务商时才需要
EO_DNS_SYNC=none            # none | dry-run | push（Web 模式下以网页设置为准）
EO_CONFIRM_DNS=no           # push 时需同时设为 yes

# ---- 异常通知（可选，飞书/企业微信/通用 webhook）----
# EO_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# ---- 挂载目录属主（默认 10001；改成宿主机你的 UID 可直接 ls 看结果）----
EO_APP_UID=10001
EO_APP_GID=10001
